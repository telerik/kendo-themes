{
  "core": {
    "workingDir": ".reg",
    "actualDir": "tests/_output",
    "thresholdRate": 0.001,
    "matchingThreshold": 0.05,
    "enableAntialias": true,
    "ximgdiff": { "invocationType": "client" }
  },
  "plugins": {
    "reg-keygen-git-hash-plugin": true,
    "reg-fetch-gh-pages-plugin": {
      "branch": "gh-pages",
      "outDir": "reports",
      "includeCommitHash": true
    }
  }
}
