{
    "$schema": "../../../schema/accessibility.schema.json",
    "ariaSpec": [
        {
            "selector": ".k-combobox .k-input-inner",
            "attribute": "role",
            "value": "combobox",
            "usage": "Identifies the input as a combobox."
        },
        {
            "selector": ".k-combobox .k-input-inner",
            "attribute": "aria-haspopup",
            "value": "listbox",
            "usage": "Indicates the combobox has a listbox popup."
        },
        {
            "selector": ".k-combobox .k-input-inner",
            "attribute": "aria-expanded",
            "usage": "Indicates whether the popup is open."
        },
        {
            "selector": ".k-combobox .k-input-inner",
            "attribute": "aria-label",
            "usage": "Accessible name for the combobox."
        },
        {
            "selector": ".k-combobox .k-input-button",
            "attribute": "aria-label",
            "usage": "Accessible name for the dropdown button."
        },
        {
            "selector": ".k-combobox .k-input-button",
            "attribute": "tabindex",
            "value": "-1",
            "usage": "Dropdown button is not in the tab order."
        },
        {
            "selector": ".k-dropdowngrid-popup .k-table-list",
            "attribute": "role",
            "value": "listbox",
            "usage": "Table list has listbox role."
        },
        {
            "selector": ".k-dropdowngrid-popup .k-table-list[role=\"listbox\"]",
            "attribute": [
                "aria-label",
                "aria-labelledby"
            ],
            "usage": "Table listbox must have an accessible name. Consuming code is responsible for associating with the component label via aria-labelledby."
        },
        {
            "selector": ".k-dropdowngrid-popup .k-table-list .k-table-row",
            "attribute": "role",
            "value": "option",
            "usage": "Each table row is an option."
        }
    ],
    "uxSpec": [],
    "kbSpec": [
        {
            "trigger": "ArrowDown",
            "behavior": "Selects the next available item."
        },
        {
            "trigger": "ArrowUp",
            "behavior": "Selects the previous available item."
        },
        {
            "trigger": "Alt/Opt(Mac) + ArrowDown",
            "behavior": "Opens pop up"
        },
        {
            "trigger": "Alt/Opt(Mac) + ArrowUp or Escape",
            "behavior": "Closes popup"
        },
        {
            "trigger": "Escape",
            "behavior": "Clears the value if popup is not visible"
        },
        {
            "trigger": "Tab",
            "behavior": "Closes the actionsheet and focuses the next focusable element."
        }
    ]
}
