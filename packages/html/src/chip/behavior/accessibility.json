{
    "$schema": "../../../schema/accessibility.schema.json",
    "ariaSpec": [
        {
            "selector": ".k-chip-list",
            "attribute": "role",
            "value": "listbox",
            "usage": "Announces the list role of the chip list."
        },
        {
            "selector": ".k-chip-list",
            "attribute": [
                "aria-label",
                "aria-labelledby"
            ],
            "usage": "Adds label to the ChipList element. ListBox element requires an accessible name."
        },
        {
            "selector": ".k-chip-list",
            "attribute": "aria-orientation",
            "value": "horizontal",
            "usage": "Specifies the horizontal orientation of the chiplist."
        },
        {
            "selector": ".k-chip-list",
            "attribute": "aria-multiselectable",
            "value": "true",
            "usage": "Announces the multiple selection ability of the chiplist."
        },
        {
            "selector": ".k-chip-list .k-chip",
            "attribute": "role",
            "value": "option",
            "usage": "Announces the chip is an option inner component of the chip list."
        },
        {
            "selector": ".k-chip-list .k-chip.k-selected",
            "attribute": "aria-selected",
            "value": "true",
            "usage": "Announces the chip is selected."
        },
        {
            "selector": ".k-chip-list .k-chip:not(.k-selected)",
            "attribute": "aria-selected",
            "value": "false",
            "usage": "Announces the chip is not selected."
        },
        {
            "selector": ".k-chip-list .k-chip:has(.k-i-x-circle), .k-chip-list .k-chip:has(.k-svg-i-x-circle)",
            "attribute": "aria-keyshortcuts",
            "value": "Enter Delete",
            "usage": "Announces the Delete action along with the default Enter key."
        }
    ],
    "kbSpec": [
        {
            "trigger": "ArrowRight",
            "behavior": "Focuses the next chip in the chiplist."
        },
        {
            "trigger": "ArrowLeft",
            "behavior": "Focuses the previous chip in the group."
        },
        {
            "behavior": "Triggers a click action on the Chip.",
            "trigger": "Enter or Space"
        },
        {
            "behavior": "Removes the Chip when a delete action is configured.",
            "trigger": "Delete or Backspace"
        }
    ],
    "uxSpec": [],
    "resources": [
        {
            "text": "WAI-ARIA Authoring Practices: Button Pattern",
            "url": "https://www.w3.org/WAI/ARIA/apg/patterns/button/"
        }
    ]
}
