{
    "$schema": "../../../schema/accessibility.schema.json",
    "ariaSpec": [
        {
            "selector": ".k-timeline.k-timeline-horizontal .k-timeline-track-wrap .k-timeline-scrollable-wrap",
            "attribute": "role",
            "value": "tablist",
            "usage": "Indicates the tablist role for the scrollable wrap element."
        },
        {
            "selector": ".k-timeline.k-timeline-horizontal .k-timeline-track-item:not(.k-timeline-flag-wrap)",
            "attribute": "role",
            "value": "tab",
            "usage": "Individual tab element on the track."
        },
        {
            "selector": ".k-timeline.k-timeline-horizontal .k-timeline-track-item:not(.k-timeline-flag-wrap).k-focus",
            "attribute": "aria-selected",
            "value": "true",
            "usage": "Announces the selected state of the focused tab."
        },
        {
            "selector": ".k-timeline.k-timeline-horizontal .k-timeline-flag-wrap",
            "attribute": "role",
            "value": "none",
            "usage": "The flag-wrap items have semantics removed."
        },
        {
            "selector": ".k-timeline.k-timeline-horizontal .k-timeline-flag-wrap",
            "attribute": "aria-hidden",
            "value": "true",
            "usage": "Flag-wrap items are hidden from the accessibility tree."
        },
        {
            "selector": ".k-timeline.k-timeline-horizontal .k-card:not(:empty)",
            "attribute": "role",
            "value": "tabpanel",
            "usage": "The card serves as the tab panel content."
        },
        {
            "selector": ".k-timeline.k-timeline-horizontal .k-card:not(:empty)",
            "attribute": "aria-label",
            "usage": "Refers to the tab element that controls the panel."
        },
        {
            "selector": ".k-timeline-arrow",
            "attribute": "aria-hidden",
            "value": "true",
            "usage": "Arrow buttons are hidden from the accessibility tree."
        },
        {
            "selector": ".k-timeline.k-timeline-vertical .k-card",
            "attribute": "role",
            "value": "button",
            "usage": "Items in the vertical timeline are buttons."
        },
        {
            "selector": ".k-timeline.k-timeline-vertical .k-card",
            "attribute": "aria-describedby",
            "usage": "Vertical timeline cards are described by their date elements."
        },
        {
            "selector": ".k-timeline.k-timeline-vertical .k-card",
            "attribute": "aria-live",
            "value": "polite",
            "usage": "Vertical timeline cards are live regions."
        },
        {
            "selector": ".k-timeline.k-timeline-vertical .k-card",
            "attribute": "tabindex",
            "value": "0",
            "usage": "Vertical timeline cards are focusable."
        },
        {
            "selector": ".k-timeline.k-timeline-collapsible .k-collapsed .k-card",
            "attribute": "aria-expanded",
            "value": "false",
            "usage": "Collapsed cards announce their collapsed state."
        },
        {
            "selector": ".k-timeline.k-timeline-collapsible .k-timeline-card:not(.k-collapsed) .k-card",
            "attribute": "aria-expanded",
            "value": "true",
            "usage": "Expanded cards announce their expanded state."
        }
    ],
    "kbSpec": [
        {
            "behavior": "Activates the previous tab (item).",
            "trigger": "ArrowLeft"
        },
        {
            "behavior": "Activates the next tab (item).",
            "trigger": "ArrowRight"
        },
        {
            "behavior": "Focuses the first item and activates it.",
            "trigger": "Home"
        },
        {
            "behavior": "Focuses the last item and activates it.",
            "trigger": "End"
        },
        {
            "behavior": "Focuses the previous item (button) in the Timeline.",
            "trigger": "Shift + Tab"
        },
        {
            "behavior": "Focuses the next item (button) in the Timeline.",
            "trigger": "Tab"
        },
        {
            "behavior": "If expandable, expands/collapses the currently focused item.",
            "trigger": "Enter"
        },
        {
            "behavior": "If expandable, expands/collapses the currently focused item.",
            "trigger": "Space"
        }
    ],
    "uxSpec": []
}
