{
    "$schema": "../../../schema/accessibility.schema.json",
    "ariaSpec": [
        {
            "selector": ".k-progressbar",
            "attribute": "role",
            "value": "progressbar",
            "usage": "Sets the proper role for ProgressBar."
        },
        {
            "selector": ".k-progressbar",
            "attribute": [
                "aria-label",
                "aria-labelledby"
            ],
            "usage": "The ProgressBar needs an accessible name to be assigned to it."
        },
        {
            "selector": ".k-progressbar:not(.k-progressbar-indeterminate)",
            "attribute": "aria-valuenow",
            "usage": "Required if the value is not indeterminate. Decimal value between aria-valuemin and aria-valuemax."
        },
        {
            "selector": ".k-progressbar",
            "attribute": "aria-valuemin",
            "usage": "Minimum value. Defaults to 0."
        },
        {
            "selector": ".k-progressbar",
            "attribute": "aria-valuemax",
            "usage": "Maximum value. Defaults to 100."
        }
    ],
    "uxSpec": [],
    "kbSpec": [],
    "resources": [
        {
            "text": "WAI-ARIA specification for progressbar",
            "url": "https://www.w3.org/TR/wai-aria-1.2/#progressbar"
        },
        {
            "text": "MDN reference for the progressbar role",
            "url": "https://developer.mozilla.org/en-US/docs/Web/Accessibility/ARIA/Roles/progressbar_role#associated_wai-aria_roles_states_and_properties"
        }
    ]
}
