{
    "$schema": "../../../schema/accessibility.schema.json",
    "ariaSpec": [
        {
            "selector": ".k-calendar-range .k-calendar-view",
            "attribute": "role",
            "value": "grid",
            "usage": "Specifies the role of the multi-view calendar wrapper."
        },
        {
            "selector": ".k-calendar-range .k-calendar-view",
            "attribute": "aria-labelledby",
            "usage": "Pointing to the k-calendar-title element."
        },
        {
            "selector": ".k-calendar-range .k-calendar-view",
            "attribute": "tabindex",
            "value": "0",
            "usage": "Makes the grid focusable."
        },
        {
            "selector": ".k-calendar-range .k-calendar-table",
            "attribute": "role",
            "value": "none",
            "usage": "Inner tables have role removed — content belongs to single grid."
        },
        {
            "selector": ".k-calendar-thead",
            "attribute": "role",
            "value": "rowgroup",
            "usage": "Explicit rowgroup role."
        },
        {
            "selector": ".k-calendar-tbody",
            "attribute": "role",
            "value": "rowgroup",
            "usage": "Explicit rowgroup role."
        },
        {
            "selector": ".k-calendar-tr",
            "attribute": "role",
            "value": "row",
            "usage": "Explicit row role."
        },
        {
            "selector": ".k-calendar-thead .k-calendar-th",
            "attribute": "role",
            "value": "columnheader",
            "usage": "Column header for day names."
        },
        {
            "selector": ".k-calendar-thead .k-calendar-th",
            "attribute": "scope",
            "value": "col",
            "usage": "Specifies the header applies to a column."
        },
        {
            "selector": ".k-calendar-thead .k-calendar-th",
            "attribute": "aria-label",
            "usage": "Full name of the day of the week."
        },
        {
            "selector": ".k-calendar-td:not(.k-alt):not(.k-empty)",
            "attribute": "role",
            "value": "gridcell",
            "usage": "Date cells in the calendar body."
        },
        {
            "selector": ".k-calendar-td.k-selected",
            "attribute": "aria-selected",
            "value": "true",
            "usage": "Indicates the selected date."
        },
        {
            "selector": ".k-calendar-td.k-disabled",
            "attribute": "aria-disabled",
            "value": "true",
            "usage": "Indicates a disabled date."
        },
        {
            "selector": ".k-calendar-nav-prev,.k-calendar-nav-next",
            "attribute": "tabindex",
            "value": "-1",
            "usage": "Navigation buttons are not focusable."
        },
        {
            "selector": ".k-calendar-title",
            "attribute": "tabindex",
            "value": "-1",
            "usage": "Title button is not focusable."
        },
        {
            "selector": ".k-calendar-nav-today",
            "attribute": "tabindex",
            "value": "-1",
            "usage": "Today link is not focusable."
        }
    ],
    "uxSpec": [],
    "kbSpec": [],
    "resources": [
        {
            "text": "ARIA practices Date Picker Dialog Example",
            "url": "https://www.w3.org/WAI/ARIA/apg/example-index/dialog-modal/datepicker-dialog.html"
        }
    ]
}
