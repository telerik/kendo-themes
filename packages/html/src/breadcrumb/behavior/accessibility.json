{
    "$schema": "../../../schema/accessibility.schema.json",
    "ariaSpec": [
        {
            "selector": ".k-breadcrumb",
            "attribute": "aria-label",
            "value": "Breadcrumb",
            "usage": "Indicates the type of navigation provided by the nav element."
        },
        {
            "selector": ".k-breadcrumb-item .k-breadcrumb-link,.k-breadcrumb-item .k-breadcrumb-root-link",
            "attribute": "role",
            "value": "link",
            "usage": "The breadcrumb item should render an <a> element or have role=\"link\".",
            "nativeElement": "a"
        },
        {
            "selector": ".k-breadcrumb-last-item .k-breadcrumb-link,.k-breadcrumb-last-item .k-breadcrumb-root-link",
            "attribute": "aria-current",
            "value": "page",
            "usage": "The last breadcrumb item points to the active page."
        },
        {
            "selector": ".k-breadcrumb-last-item .k-breadcrumb-link",
            "attribute": "aria-disabled",
            "value": "true",
            "usage": "The last breadcrumb item is disabled."
        },
        {
            "selector": ".k-breadcrumb-delimiter-icon",
            "attribute": "aria-hidden",
            "value": "true",
            "usage": "Delimiter icon should not be accessed through assistive technology."
        }
    ],
    "kbSpec": [
        {
            "behavior": "Focuses next and previous breadcrumb items. The focusable element is the element with either `a` tag, or `role=\\\"link\\\"`",
            "trigger": "Tab or Shift + Tab"
        },
        {
            "behavior": "Selects the Bredcrumb item, and navigates to it (if navigatable).",
            "trigger": "Enter"
        }
    ],
    "uxSpec": []
}
