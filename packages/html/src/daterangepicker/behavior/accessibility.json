{
    "$schema": "../../../schema/accessibility.schema.json",
    "ariaSpec": [
        {
            "selector": ".k-daterangepicker .k-input-inner",
            "attribute": [
                "aria-label",
                "aria-labelledby"
            ],
            "usage": "Each date input needs an accessible name."
        }
    ],
    "kbSpec": [
        {
            "behavior": "Closes the popup",
            "trigger": "Escape"
        },
        {
            "behavior": "Opens the popup",
            "trigger": "Alt/Opt(Mac) + ArrowDown"
        },
        {
            "behavior": "Closes the popup",
            "trigger": "Alt/Opt(Mac) + ArrowUp"
        }
    ],
    "uxSpec": [],
    "resources": [
        {
            "text": "WAI ARIA specification for combobox",
            "url": "https://www.w3.org/TR/wai-aria-1.2/#combobox"
        },
        {
            "text": "ARIA practices Date Picker Dialog Example",
            "url": "https://www.w3.org/WAI/ARIA/apg/example-index/dialog-modal/datepicker-dialog.html"
        }
    ]
}
