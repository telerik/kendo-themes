{
    "$schema": "../../../schema/accessibility.schema.json",
    "ariaSpec": [
        {
            "selector": ".k-drawer ul",
            "attribute": "role",
            "value": "menubar",
            "usage": "Indicates that the list of drawer items is a menubar."
        },
        {
            "selector": ".k-drawer ul",
            "attribute": "aria-orientation",
            "value": "vertical",
            "usage": "Indicates that the orientation of the drawer is vertical."
        },
        {
            "selector": ".k-drawer-item:not(.k-drawer-separator)",
            "attribute": "role",
            "value": "menuitem",
            "usage": "Indicates that the item of a drawer serves as a menuitem."
        },
        {
            "selector": ".k-drawer-item.k-drawer-separator",
            "attribute": "role",
            "value": "separator",
            "usage": "Indicates that the item of a drawer serves as a separator."
        }
    ],
    "kbSpec": [
        {
            "behavior": "Execute the item action",
            "trigger": "Enter"
        },
        {
            "behavior": "Goes to the previous item. Focus is moved to the prev item and its tabindex is set to 0.",
            "trigger": "ArrowUp"
        },
        {
            "behavior": "Goes to the next item. Focus is moved to the next item and its tabindex is set to 0.",
            "trigger": "ArrowDown"
        }
    ],
    "uxSpec": []
}
