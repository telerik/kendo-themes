{
    "$schema": "../../../schema/accessibility.schema.json",
    "ariaSpec": [
        {
            "selector": ".k-combobox > .k-input-inner",
            "attribute": "role",
            "value": "combobox",
            "usage": "Identifies the input as a combobox."
        },
        {
            "selector": ".k-combobox > .k-input-inner",
            "attribute": "aria-haspopup",
            "value": "listbox",
            "usage": "Indicates the combobox has a listbox popup."
        },
        {
            "selector": ".k-combobox > .k-input-inner",
            "attribute": "aria-expanded",
            "usage": "Indicates whether the popup is open."
        },
        {
            "selector": ".k-combobox > .k-input-inner",
            "attribute": "aria-controls",
            "value": "${id}-listbox",
            "usage": "Points to the listbox element when popup is open."
        },
        {
            "selector": ".k-combobox > .k-input-inner",
            "attribute": "aria-activedescendant",
            "usage": "Points to the focused item in the listbox."
        },
        {
            "selector": ".k-combobox > .k-input-inner",
            "attribute": "aria-autocomplete",
            "usage": "Indicates the autocomplete behavior.",
            "value": [
                "list",
                "both",
                "inline"
            ]
        },
        {
            "selector": ".k-combobox > .k-input-inner",
            "attribute": "aria-invalid",
            "value": "true",
            "usage": "Rendered when the combobox is in an invalid state."
        },
        {
            "selector": ".k-combobox > .k-input-inner",
            "attribute": "aria-busy",
            "value": "true",
            "usage": "Rendered when the combobox is loading data."
        },
        {
            "selector": ".k-combobox > .k-input-inner",
            "attribute": [
                "aria-label",
                "aria-labelledby"
            ],
            "usage": "Accessible name provided by consuming app."
        },
        {
            "selector": ".k-combobox.k-disabled > .k-input-inner",
            "attribute": "aria-disabled",
            "value": "true",
            "usage": "Rendered when the combobox is disabled.",
            "nativeAttribute": "disabled"
        },
        {
            "selector": ".k-combobox .k-input-button",
            "attribute": "role",
            "value": "button",
            "usage": "The dropdown toggle button.",
            "nativeElement": "button"
        },
        {
            "selector": ".k-combobox .k-input-button",
            "attribute": "aria-label",
            "usage": "Accessible name for the dropdown button."
        },
        {
            "selector": ".k-combobox .k-input-button",
            "attribute": "tabindex",
            "value": "-1",
            "usage": "Dropdown button is not in the tab order."
        },
        {
            "selector": ".k-combobox-popup .k-list-content, .k-combobox-popup .k-list-ul",
            "attribute": "role",
            "value": "listbox",
            "usage": "The popup list container has the listbox role."
        },
        {
            "selector": ".k-combobox-popup .k-list-ul[role=\"listbox\"], .k-combobox-popup .k-list-content[role=\"listbox\"]",
            "attribute": [
                "aria-label",
                "aria-labelledby"
            ],
            "usage": "Popup listbox must have an accessible name. Consuming code is responsible for associating with the component label via aria-labelledby."
        },
        {
            "selector": ".k-combobox-popup .k-list-item",
            "attribute": "role",
            "value": "option",
            "usage": "Each list item is an option."
        },
        {
            "selector": ".k-combobox-popup .k-list-item",
            "attribute": "aria-selected",
            "usage": "Indicates the selected state."
        },
        {
            "selector": ".k-combobox-popup .k-no-data",
            "attribute": "aria-live",
            "value": "polite",
            "usage": "Announces no-data state to screen readers."
        }
    ],
    "kbSpec": [
        {
            "behavior": "Focuses the matched item.",
            "trigger": "Typing in the input"
        },
        {
            "behavior": "Highlights the next available item.",
            "trigger": "ArrowDown"
        },
        {
            "behavior": "Highlights the previous available item.",
            "trigger": "ArrowUp"
        },
        {
            "behavior": "Selects the focused item.",
            "trigger": "Enter"
        },
        {
            "behavior": "Opens the popup.",
            "trigger": "Alt/Opt(Mac) + ArrowDown"
        },
        {
            "behavior": "Closes the popup.",
            "trigger": "Alt/Opt(Mac) + ArrowUp or Escape"
        },
        {
            "behavior": "If the popup is not visible, clears the value.",
            "trigger": "Escape"
        }
    ],
    "uxSpec": [],
    "resources": [
        {
            "text": "WAI-ARIA Authoring Practices: Editable Combobox With Both List and Inline Autocomplete Example",
            "url": "https://www.w3.org/WAI/ARIA/apg/example-index/combobox/combobox-autocomplete-both.html"
        },
        {
            "text": "WAI-ARIA Authoring Practices: Editable Combobox With List Autocomplete Example",
            "url": "https://www.w3.org/WAI/ARIA/apg/example-index/combobox/combobox-autocomplete-list.html"
        }
    ]
}
