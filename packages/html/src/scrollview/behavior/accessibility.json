{
    "$schema": "../../../schema/accessibility.schema.json",
    "ariaSpec": [
        {
            "selector": ".k-scrollview",
            "attribute": "role",
            "value": "application",
            "usage": "Specifies the role of the Carousel element."
        },
        {
            "selector": ".k-scrollview",
            "attribute": "aria-roledescription",
            "value": "carousel",
            "usage": "Clarifies the role of the Carousel element."
        },
        {
            "selector": ".k-scrollview",
            "attribute": "tabindex",
            "value": "0",
            "usage": "Carousel element must be focusable."
        },
        {
            "selector": ".k-scrollview-wrap",
            "attribute": "role",
            "value": "list",
            "usage": "Clarifies the scrollview wrap as a list of items (images)."
        },
        {
            "selector": ".k-scrollview-wrap>*",
            "attribute": "role",
            "value": "listitem",
            "usage": "Specifies the role of each Carousel item."
        },
        {
            "selector": ".k-scrollview-wrap>*",
            "attribute": "aria-roledescription",
            "value": "slide",
            "usage": "Clarifies the role of the Carousel item."
        },
        {
            "selector": ".k-scrollview-prev,.k-scrollview-next",
            "attribute": "role",
            "value": "button",
            "usage": "Specifies the role of the Previous/Next button."
        },
        {
            "selector": ".k-scrollview-prev,.k-scrollview-next",
            "attribute": "aria-label",
            "usage": "Specifies label for the Previous/Next button."
        },
        {
            "selector": ".k-scrollview-prev,.k-scrollview-next",
            "attribute": "aria-controls",
            "usage": "Points to the id of the items container element."
        },
        {
            "selector": ".k-scrollview>.k-sr-only",
            "attribute": "aria-live",
            "value": "polite",
            "usage": "Identifies a hidden element as a live region in the polite state."
        }
    ],
    "uxSpec": [],
    "kbSpec": [],
    "resources": [
        {
            "text": "ARIA Practices: Carousel",
            "url": "https://www.w3.org/WAI/ARIA/apg/patterns/carousel/"
        },
        {
            "text": "ARIA Practices: Carousel Example with Buttons",
            "url": "https://www.w3.org/WAI/ARIA/apg/example-index/carousel/carousel-1-prev-next.html"
        }
    ]
}
