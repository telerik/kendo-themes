{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "composite": true,
        "target": "es2020",
        "lib": ["es2020"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": ["node"],
        "isolatedModules": true,
        "esModuleInterop": true,
        "noEmit": true,
        "strictFunctionTypes": true,
        "noImplicitAny": false,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "strictNullChecks": true
    },
    "include": [
        "vite.config.ts"
    ]
}
