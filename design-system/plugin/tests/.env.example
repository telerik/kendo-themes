# ─────────────────────────────────────────────────────────────────────────────
# Kendo Design System Plugin — Eval Environment
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# This file is gitignored — never commit secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Required: Your model endpoint
KENDO_EVAL_PROVIDER_URL=https://api.openai.com/v1

# Required: API key for the endpoint
KENDO_EVAL_API_KEY=sk-your-key-here

# Required: Model identifier sent to the provider
KENDO_EVAL_MODEL=gpt-5.4

# Optional: Well-known model ID (if wire model differs from base)
# KENDO_EVAL_MODEL_ID=gpt-5.4
