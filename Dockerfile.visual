# Pinned capture environment for deterministic visual regression.
# Fixes Windows-vs-Linux font/AA drift by running the same container locally and in CI.
#
# Uses the official Playwright image directly: it already ships the matching
# Chromium/Firefox/WebKit build for its tag plus the OS fonts needed for
# consistent rendering, so no extra `playwright install` or font packages are
# needed here - this file just adds the working directory for local captures.
#
# Build & push (once, or when the CI image tag is bumped):
#   docker build -f Dockerfile.visual -t ghcr.io/telerik/kendo-visual:1 .
#   docker push ghcr.io/telerik/kendo-visual:1
#
# Local canonical capture (pixel-identical to CI):
#   docker run --rm -v "${PWD}:/work" -w /work ghcr.io/telerik/kendo-visual:1 \
#     node scripts/capture.mjs --themes meridian --components '*'
#
# Determinism contract: keep this tag identical to the `container:` image used
# in .github/workflows/_create-screenshots.yml, and to the `playwright` dep in
# package.json, whenever any of them is bumped.
FROM mcr.microsoft.com/playwright:v1.62.1-noble

WORKDIR /work
